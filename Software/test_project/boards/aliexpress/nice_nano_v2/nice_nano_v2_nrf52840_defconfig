# NOTE: Do not force architecture-level options here. Let the SoC/arch Kconfig
# set MPU-related symbols. Forcing CONFIG_ARM_MPU early can lead to Kconfig
# warnings (assigned 'y' but got 'n') because CPU_HAS_MPU may not be set yet.
# CONFIG_ARM_MPU=y

# Use pinctrl
CONFIG_PINCTRL=y

# Enable GPIO
CONFIG_GPIO=y

# UF2 bootloader support
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Flash support
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Settings storage
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
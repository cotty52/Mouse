cmake:
  board:
    name: 'nrf52840gmouse'
    path:
     - 'C:/ncs/v3.1.1/nrf/boards/nordic/nrf52840gmouse'
    qualifiers: 'nrf52840'
    revision: ''
  images:
   - name: 'nrf_desktop_6'
     source-dir: 'D:/GitHub/Mouse/Software/nrf_desktop_6'
     type: 'MAIN'
   - name: 'b0'
     source-dir: ''
   - name: 's1_image'
     source-dir: ''
  kconfig:
    files:
     - 'D:/GitHub/Mouse/Software/nrf_desktop_6/build_1/_sysbuild/empty.conf'
     - 'D:/GitHub/Mouse/Software/nrf_desktop_6/sysbuild/../configuration/nrf52840gmouse_nrf52840/sysbuild.conf'
    user-files:
     - 'D:/GitHub/Mouse/Software/nrf_desktop_6/sysbuild/../configuration/nrf52840gmouse_nrf52840/sysbuild.conf'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\c1a76fddb2\opt\bin\Scripts\west build --build-dir d:/GitHub/Mouse/Software/nrf_desktop_6/build_1 d:/GitHub/Mouse/Software/nrf_desktop_6 --pristine --board nrf52840gmouse/nrf52840 --sysbuild -- -DDEBUG_THREAD_INFO=Off -Dnrf_desktop_6_DEBUG_THREAD_INFO=Off -Db0_DEBUG_THREAD_INFO=Off -Ds1_image_DEBUG_THREAD_INFO=Off'
  topdir: 'd:\GitHub\Mouse\Software'
  version: '1.4.0'
